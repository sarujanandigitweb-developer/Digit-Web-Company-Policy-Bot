# Copy to .env and fill in. At least one provider key is required.
#
# The AI gateway tries providers in the order below, skipping any whose key is
# missing and falling back on rate limits, timeouts, network faults and server
# errors. Each *_MODEL is optional and overrides the default in
# src/lib/ai/providers.server.ts.

# 1. Gemini via the Lovable gateway — injected in Lovable hosting, unset locally
LOVABLE_API_KEY=
LOVABLE_MODEL=google/gemini-3-flash-preview

# 2. Gemini direct — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# 3. Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# 5. Self-hosted Qwen (llama.cpp, OpenAI-compatible) — the last resort.
# Every provider above depends on someone else's quota, key or model id staying
# valid. This one is ours, so it is what answers when the hosted chain is down.
# Context window is 32k; the retrieval prompt fits, whole documents would not.
QWEN_API_KEY=
QWEN_MODEL=Qwen3-Next-80B-A3B-Instruct-Q4_K_M.gguf
QWEN_BASE_URL=https://qwen3next.severdigitweb.uk/v1

# Optional: first-token timeout before falling back (ms). Default 20000.
# AI_FIRST_CHUNK_TIMEOUT_MS=20000

# --- Neon Postgres ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Neon Auth (Console -> Project -> Auth) ---
NEON_AUTH_URL=
VITE_NEON_AUTH_URL=

# --- Chat knowledge source ---
# KNOWLEDGE_SOURCE=database   # or 'transcript' to roll back to the Drive doc
# KNOWLEDGE_CONFIDENCE_FLOOR=0.5

# --- Password-reset email (self-hosted 6-digit OTP) ---
# SMTP is used to email the reset code. For Gmail, SMTP_PASS is a 16-char App
# Password (Google Account -> Security -> App passwords), NOT your login password.
# Runs over TCP, so the server route must run on a Node runtime (not edge).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                       # 465 = implicit TLS; 587 = STARTTLS
SMTP_USER=                          # e.g. you@gmail.com
SMTP_PASS=                          # 16-char Gmail App Password (no spaces)
SMTP_FROM=                          # optional; defaults to "Ask the Digit <SMTP_USER>"
# How long a code stays valid (minutes) and how many can be requested per hour.
# PASSWORD_RESET_TTL_MINUTES=10
# PASSWORD_RESET_MAX_PER_HOUR=5

# Dedicated Neon Auth service account used ONLY to write the new password via
# the Better Auth admin API. Must have role='admin' in neon_auth."user".
# Create it with scripts/setup-auth-service.sh (it fills these in).
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# --- Document Library (user-facing Google Sheet/Drive feature) ---
# Isolated from the Admin Knowledge Library above: this reads a Google Sheet's
# hierarchy and fetches Drive documents directly, with no chunking/embedding.
# See src/lib/services/google-sheet.server.ts, google-drive.server.ts,
# google-library.server.ts.
#
# The Sheet ID/gid below default to the sheet already in use if left unset.
# LIBRARY_SHEET_ID=1WAmQUBZTyyqPiHE11IMopYMav3Rab2koHKwninUJDzA
# LIBRARY_SHEET_GID=1900841522

# Optional. Without these, a document/file that is "anyone with the link"
# shared can still be read (verified: works with zero credentials). A Drive
# FOLDER cannot be listed without one — Drive's API refuses even an API key
# for that call. Create at console.cloud.google.com: enable the Drive API,
# create a Service Account, download its JSON key, then share the Drive root
# folder with the service account's own email address (Viewer is enough).
# GOOGLE_SA_CLIENT_EMAIL=
# GOOGLE_SA_PRIVATE_KEY=

# Conversation retention: set a fresh random secret in Vercel Production before deploy.
# Vercel sends this as a Bearer token to the daily retention endpoint.
CRON_SECRET=
