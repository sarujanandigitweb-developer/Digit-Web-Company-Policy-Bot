# Copy to .env and fill in. At least one provider key is required.
#
# The AI gateway tries providers in the order below, skipping any whose key is
# missing and falling back on rate limits, timeouts, network faults and server
# errors. Each *_MODEL is optional and overrides the default in
# src/lib/ai/providers.server.ts.

# 1. Gemini via the Lovable gateway — injected in Lovable hosting, unset locally
LOVABLE_API_KEY=
LOVABLE_MODEL=google/gemini-3-flash-preview

# 2. Gemini direct — https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3-flash-preview

# 3. Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 4. OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Optional: first-token timeout before falling back (ms). Default 20000.
# AI_FIRST_CHUNK_TIMEOUT_MS=20000
